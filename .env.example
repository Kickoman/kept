# Copy to .env and adjust.
SECRET_KEY=change-me-to-a-long-random-string
# Host port the container is published on (127.0.0.1 only); your reverse proxy forwards to it.
PORT=8000
# uid/gid the app runs as inside the container: use your own (id -u / id -g) so ./data is yours.
APP_UID=1000
APP_GID=1000
# Where sqlite + uploaded images live. Docker compose sets DATA_DIR=/data (mounted from ./data);
# for local runs leave these unset to use ./data.
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/wishlist.db
# Optional. Public origin of the site (e.g. https://kept.example). Leave empty to derive it from each request
# (works behind a reverse proxy that passes the original Host header and X-Forwarded-Proto — Caddy, Traefik
# and nginx with `proxy_set_header Host $host` do). Set it only if your proxy does not.
BASE_URL=
# AI providers. These are only defaults: the admin UI (Admin → AI) stores the live configuration in the database.
# TEXT_PROVIDER: none | anthropic | yandex   IMAGE_PROVIDER: none | yandex
TEXT_PROVIDER=none
IMAGE_PROVIDER=none
ANTHROPIC_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Log verbosity: debug | info | warning | error. Logs are JSON lines on stdout.
LOG_LEVEL=info
# Comma-separated usernames that become administrators (flag is set at startup and on registration).
ADMIN_USERNAMES=
# Orphan media cleanup: every N hours (0 = off); files younger than the TTL are kept.
MEDIA_SWEEP_HOURS=24
MEDIA_ORPHAN_TTL_HOURS=24
