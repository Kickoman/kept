# Example nginx site for Kept. Replace example.com with your domain and 8000
# with the PORT from .env, then add TLS (e.g. `certbot --nginx -d example.com`).
server {
	server_name example.com;
	listen 80;

	client_max_body_size 6m;   # image uploads are capped at 5 MB in the app

	location / {
		proxy_pass http://127.0.0.1:8000;
		proxy_http_version 1.1;
		# The app builds share links and cookie flags from these headers.
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}
